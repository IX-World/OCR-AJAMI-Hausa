{"file_name": "a_ajami_00001.png", "transcript": "Bismi l-Lāhi al-Raḥmāni al-Raḥīm Ṣallallāhu ʿalā l-Nabiyyi l-Karīm", "source": "11"}
{"file_name": "a_ajami_00002.png", "transcript": "Bismi l-Lāhi al-Raḥmāni al-Rahīmi Ṣala l-Lāhu ʿalā Sayyidinā Muḥammad wa ālihī wa ṣaḥbihī wa sallam", "source": "3"}
{"file_name": "a_ajami_00003.png", "transcript": "Bismi l-Lāhi Rabbanā ba ni sa'a", "source": "3"}
{"file_name": "a_ajami_00004.png", "transcript": "Jama’a du ku karkaɗe kunnuwanku", "source": "3"}
{"file_name": "a_ajami_00005.png", "transcript": "Gantali gantafalfala ba ku aiki", "source": "3"}
{"file_name": "a_ajami_00006.png", "transcript": "Mai yawo cikin gari ba dalili", "source": "3"}
{"file_name": "a_ajami_00007.png", "transcript": "Ba ya arziƙi mutin dun ku gane", "source": "3"}
{"file_name": "a_ajami_00008.png", "transcript": "In an ganshi ma da riga ta kirki", "source": "3"}
{"file_name": "a_ajami_00009.png", "transcript": "Dole a sha jinin jiki man a ce mai", "source": "3"}
{"file_name": "a_ajami_00010.png", "transcript": "Ƙarshe sai a dinga ce mar ɓarawo", "source": "3"}
{"file_name": "a_ajami_00011.png", "transcript": "Ba zai ce da kaifa to mai na ɗauka", "source": "3"}
{"file_name": "a_ajami_00012.png", "transcript": "Nema nai ake akama a ɗaure", "source": "3"}
{"file_name": "a_ajami_00013.png", "transcript": "Da ka ce ko da shifa kyat sai ya ruga", "source": "3"}
{"file_name": "a_ajami_00014.png", "transcript": "Sanan kun ga du mutane na kirki", "source": "3"}
{"file_name": "a_ajami_00015.png", "transcript": "Kuma firarsu kar ku soma ku jita", "source": "3"}
{"file_name": "a_ajami_00016.png", "transcript": "Kuma ko za’a ce cikinmu cikinmu", "source": "3"}
{"file_name": "a_ajami_00017.png", "transcript": "Wa ye mai zaman zato don a bashi", "source": "3"}
{"file_name": "a_ajami_00018.png", "transcript": "Ko sata akai a kudan ku gane", "source": "3"}
{"file_name": "a_ajami_00019.png", "transcript": "Zan waƙar waɗanda ba sa sana’a", "source": "3"}
{"file_name": "a_ajami_00020.png", "transcript": "Ku ji waƙar waɗanda ba sa sana’a", "source": "3"}
{"file_name": "a_ajami_00021.png", "transcript": "Ko ko ba ku so a ce ku yi sana’a", "source": "3"}
{"file_name": "a_ajami_00022.png", "transcript": "Ba aikin fari ba ƙi ba sana’a", "source": "3"}
{"file_name": "a_ajami_00023.png", "transcript": "Mutu ƙar anka ce fa ba ya sana’a", "source": "3"}
{"file_name": "a_ajami_00024.png", "transcript": "Sai an sha jinin jiki babu a’a", "source": "3"}
{"file_name": "a_ajami_00025.png", "transcript": "A ina za ya san kuɗi bai sana’a", "source": "3"}
{"file_name": "a_ajami_00026.png", "transcript": "Suna ne na wanda ba ya sana’a", "source": "3"}
{"file_name": "a_ajami_00027.png", "transcript": "Tsoro zai ji kar a je gun shari’a", "source": "3"}
{"file_name": "a_ajami_00028.png", "transcript": "Bai rasa laifuka wajan mai shari’a", "source": "3"}
{"file_name": "a_ajami_00029.png", "transcript": "Marashin gaskiya marar yin sana’a", "source": "3"}
{"file_name": "a_ajami_00030.png", "transcript": "Ba su amince wa marar yin sana’a", "source": "3"}
{"file_name": "a_ajami_00031.png", "transcript": "Zagin malamai masu ɗa’a", "source": "3"}
{"file_name": "a_ajami_00032.png", "transcript": "Waye mai kuwa ɗai marar yin sana’a", "source": "3"}
{"file_name": "a_ajami_00033.png", "transcript": "Cenai mai mutun marar yin sana’a", "source": "3"}
{"file_name": "a_ajami_00034.png", "transcript": "Sai an sha waɗanda ba sa sana’a", "source": "3"}
{"file_name": "a_ajami_00035.png", "transcript": "Mai toshasshiyar basira daƙiƙi", "source": "3"}
{"file_name": "a_ajami_00036.png", "transcript": "Mai roƙon ɗari kuwa bogen waninsa", "source": "3"}
{"file_name": "a_ajami_00037.png", "transcript": "Da ya roƙeka, ce da shi ba ka ba shi", "source": "3"}
{"file_name": "a_ajami_00038.png", "transcript": "Gara ka baiwa mahaukaci ma abinci", "source": "3"}
{"file_name": "a_ajami_00039.png", "transcript": "In ka ba shi ka ga ka saɓi Allah", "source": "3"}
{"file_name": "a_ajami_00040.png", "transcript": "Ko za ka faman hana sa a bashi", "source": "3"}
{"file_name": "a_ajami_00041.png", "transcript": "Kuma firarsu ca suke wane rowa", "source": "3"}
{"file_name": "a_ajami_00042.png", "transcript": "Da ka ce wane na da rowa kwaɗayinka", "source": "3"}
{"file_name": "a_ajami_00043.png", "transcript": "Tafi wofi, ba zan abota da kai ba", "source": "3"}
{"file_name": "a_ajami_00044.png", "transcript": "Nassi ne ya ce ba’a ƙaryata ba", "source": "3"}
{"file_name": "a_ajami_00045.png", "transcript": "Sai aikin assha kawai ba na kirki", "source": "3"}
{"file_name": "a_ajami_00046.png", "transcript": "Kuma san zuciya a nanne ya zauna", "source": "3"}
{"file_name": "a_ajami_00047.png", "transcript": "Ko ban san kuɗi ba, na gode Allah", "source": "3"}
{"file_name": "a_ajami_00048.png", "transcript": "In Allah ya so wulaƙanta bawa", "source": "3"}
{"file_name": "a_ajami_00049.png", "transcript": "Ba a ce kaza na da muni", "source": "3"}
{"file_name": "a_ajami_00050.png", "transcript": "Da ya ga kuɗinka, yai kamar za ya ƙwace", "source": "3"}
{"file_name": "a_ajami_00051.png", "transcript": "Sai ya yi sana’a kayar, shi ya ɗauka", "source": "3"}
{"file_name": "a_ajami_00052.png", "transcript": "Shi mai sammakon fitar kasuwa ne", "source": "3"}
{"file_name": "a_ajami_00053.png", "transcript": "Shine ke zama yake ƙin sana’a", "source": "3"}
{"file_name": "a_ajami_00054.png", "transcript": "Gara ka daina yi ka je kai sana’a", "source": "3"}
{"file_name": "a_ajami_00055.png", "transcript": "Kar ka ji tausayin marar yin sana’a", "source": "3"}
{"file_name": "a_ajami_00056.png", "transcript": "Da ka baiwa mutum marar yin sana’a", "source": "3"}
{"file_name": "a_ajami_00057.png", "transcript": "In ka hanashi ka bi ƙaulin Shari’a", "source": "3"}
{"file_name": "a_ajami_00058.png", "transcript": "Mai ɓarnar ƙuɗi, marar yin sana’a", "source": "3"}
{"file_name": "a_ajami_00059.png", "transcript": "Sun yi suka ga wanda ke yin sana’a", "source": "3"}
{"file_name": "a_ajami_00060.png", "transcript": "Kwaɗayi na ga wanda ba ya sana’a", "source": "3"}
{"file_name": "a_ajami_00061.png", "transcript": "Dan ni ba ni san marar kyan sana’a", "source": "3"}
{"file_name": "a_ajami_00062.png", "transcript": "Kar a ku sanci wanda ba ya sana’a", "source": "3"}
{"file_name": "a_ajami_00063.png", "transcript": "A wajen wanda ke zama ba sana’a", "source": "3"}
{"file_name": "a_ajami_00064.png", "transcript": "Can gun wanda ke zama ba sana’a", "source": "3"}
{"file_name": "a_ajami_00065.png", "transcript": "A ce dai da ni ina yin sana’a", "source": "3"}
{"file_name": "a_ajami_00066.png", "transcript": "Sai ka tarar da shi fa ba ya sana’a", "source": "3"}
{"file_name": "a_ajami_00067.png", "transcript": "Mai gaba da malamai masu ɗa’a", "source": "3"}
{"file_name": "a_ajami_00068.png", "transcript": "Shi ko baida ƙoƙarin ya yi sana’a", "source": "3"}
{"file_name": "a_ajami_00069.png", "transcript": "Ka ji wofi da ba ya so ya yi sana’a", "source": "3"}
{"file_name": "a_ajami_00070.png", "transcript": "Ba ya je bane fa dan ya yi sana’a", "source": "3"}
{"file_name": "a_ajami_00071.png", "transcript": "Neman tsuntuwa fa shine ya kaishi", "source": "3"}
{"file_name": "a_ajami_00072.png", "transcript": "To in banda ma basira ta toshe", "source": "3"}
{"file_name": "a_ajami_00073.png", "transcript": "A zaune fa arziki ba zai taddaku ba", "source": "3"}
{"file_name": "a_ajami_00074.png", "transcript": "A sa’o’inka kowanne in ka duba", "source": "3"}
{"file_name": "a_ajami_00075.png", "transcript": "To kai me ya sa ka zauna ka miƙe", "source": "3"}
{"file_name": "a_ajami_00076.png", "transcript": "Bari yin ta ƙama da kai malami ne", "source": "3"}
{"file_name": "a_ajami_00077.png", "transcript": "Mai neman shina da shi mai sanarwa", "source": "3"}
{"file_name": "a_ajami_00078.png", "transcript": "An ce malamin da ba ya sana’a", "source": "3"}
{"file_name": "a_ajami_00079.png", "transcript": "Annabi shugabanmu ma yai fatauci", "source": "3"}
{"file_name": "a_ajami_00080.png", "transcript": "A cikin Samraqandi an san sana’a", "source": "3"}
{"file_name": "a_ajami_00081.png", "transcript": "Ibrahima annabi ne na Allah", "source": "3"}
{"file_name": "a_ajami_00082.png", "transcript": "Annabi Dawuda an faɗa ya yi ƙīra", "source": "3"}
{"file_name": "a_ajami_00083.png", "transcript": "Annabi Ya’u yai kafinta shi ko", "source": "3"}
{"file_name": "a_ajami_00084.png", "transcript": "Du mai sansu ko ashe wajibi ne", "source": "3"}
{"file_name": "a_ajami_00085.png", "transcript": "Ko gata fa za ka nunawa ɗanka", "source": "3"}
{"file_name": "a_ajami_00086.png", "transcript": "An ce kar ka ce kuɗi ne akwai su", "source": "3"}
{"file_name": "a_ajami_00087.png", "transcript": "In kuma babu kai fa, wa za ya bashi?", "source": "3"}
{"file_name": "a_ajami_00088.png", "transcript": "Kuma ƴaƴansa sai su zo mar ya basu", "source": "3"}
{"file_name": "a_ajami_00089.png", "transcript": "Sana banza yana ga munin sana’a", "source": "3"}
{"file_name": "a_ajami_00090.png", "transcript": "Yaya za ku ɗau zama ba sana’a", "source": "3"}
{"file_name": "a_ajami_00091.png", "transcript": "Ai sai kun biɗeshi sai kun sana’a", "source": "3"}
{"file_name": "a_ajami_00092.png", "transcript": "Sai ka ga kowanne yana yin sana’a", "source": "3"}
{"file_name": "a_ajami_00093.png", "transcript": "Kake roƙonsu ba ka so ka yi sana’a?", "source": "3"}
{"file_name": "a_ajami_00094.png", "transcript": "Karatu shi ya ce a je a yi sana’a", "source": "3"}
{"file_name": "a_ajami_00095.png", "transcript": "Ba a ce ko waninsa kar ya yi sana’a", "source": "3"}
{"file_name": "a_ajami_00096.png", "transcript": "Zai san zuciya ya kauce sharīʿah", "source": "3"}
{"file_name": "a_ajami_00097.png", "transcript": "In koyi kake da shi, ka yi sana’a", "source": "3"}
{"file_name": "a_ajami_00098.png", "transcript": "Wacce ta nuna wajibun a yi sana’a", "source": "3"}
{"file_name": "a_ajami_00099.png", "transcript": "Kuma ya fi ka, ka gani yai sana’a", "source": "3"}
{"file_name": "a_ajami_00100.png", "transcript": "Yai sulke ku tabbatar yai sana’a", "source": "3"}
{"file_name": "a_ajami_00101.png", "transcript": "Kowanne cikinsu dai yai sana’a", "source": "3"}
{"file_name": "a_ajami_00102.png", "transcript": "Ya yi koyi da su mutum ya yi sana’a", "source": "3"}
{"file_name": "a_ajami_00103.png", "transcript": "An ce kar ka barshi ba ya sana’a", "source": "3"}
{"file_name": "a_ajami_00104.png", "transcript": "Ai ka ba shi ya yi zama ba sana’a", "source": "3"}
{"file_name": "a_ajami_00105.png", "transcript": "Ba mai bashi gashi ba ya sana’a", "source": "3"}
{"file_name": "a_ajami_00106.png", "transcript": "A ina za ya zam kuɗi bai sana’a?", "source": "3"}
{"file_name": "a_ajami_00107.png", "transcript": "To ai kun ga akhira ta yi muni", "source": "3"}
{"file_name": "a_ajami_00108.png", "transcript": "Har abada cikin shukuna da yinwa", "source": "3"}
{"file_name": "a_ajami_00109.png", "transcript": "Du a gari ko babu mai ba su bashi", "source": "3"}
{"file_name": "a_ajami_00110.png", "transcript": "Mata ma ashe suna son na kirki", "source": "3"}
{"file_name": "a_ajami_00111.png", "transcript": "Ba birni ba kun gani ko a ƙauye", "source": "3"}
{"file_name": "a_ajami_00112.png", "transcript": "Kai ni na tsaya fa tsaina ku duba", "source": "3"}
{"file_name": "a_ajami_00113.png", "transcript": "Domin ko kare akwai masu son sa", "source": "3"}
{"file_name": "a_ajami_00114.png", "transcript": "Wanda kare ya fishi shi yai asara", "source": "3"}
{"file_name": "a_ajami_00115.png", "transcript": "Ni nai man tsari nake kar na gansu", "source": "3"}
{"file_name": "a_ajami_00116.png", "transcript": "Da kuma za su shiryu da sai na sosu", "source": "3"}
{"file_name": "a_ajami_00117.png", "transcript": "Halinku fa shi kawai ake ƙi ku gane", "source": "3"}
{"file_name": "a_ajami_00118.png", "transcript": "Kuma ni yanzu shawarata gareku", "source": "3"}
{"file_name": "a_ajami_00119.png", "transcript": "To amma fa ga ka shedi gareka", "source": "3"}
{"file_name": "a_ajami_00120.png", "transcript": "Kar ku yi daudu kun ga kar ku yi kawalci", "source": "3"}
{"file_name": "a_ajami_00121.png", "transcript": "Abin da ya sa na ce kar ku yi su", "source": "3"}
{"file_name": "a_ajami_00122.png", "transcript": "Gantali koko yanzu zan tarbeku", "source": "3"}
{"file_name": "a_ajami_00123.png", "transcript": "Ba kuwa a ce da ni fa da san jiki ba", "source": "3"}
{"file_name": "a_ajami_00124.png", "transcript": "Ko kun fid da rai da yin arziƙi ne", "source": "3"}
{"file_name": "a_ajami_00125.png", "transcript": "Girma yari ga ya zau ba sana’a", "source": "3"}
{"file_name": "a_ajami_00126.png", "transcript": "Yinwa na cikin mara yin sana’a", "source": "3"}
{"file_name": "a_ajami_00127.png", "transcript": "Don ba sa biya marasa sana’a", "source": "3"}
{"file_name": "a_ajami_00128.png", "transcript": "Don ni na ga sun fi son mai sana’a", "source": "3"}
{"file_name": "a_ajami_00129.png", "transcript": "Baida farin jini marar yin sana’a", "source": "3"}
{"file_name": "a_ajami_00130.png", "transcript": "Ban hango masu marar yin sana’a", "source": "3"}
{"file_name": "a_ajami_00131.png", "transcript": "Ba mai san mutum marar yin sana’a", "source": "3"}
{"file_name": "a_ajami_00132.png", "transcript": "Auzu min waɗanda ba sa sana’a", "source": "3"}
{"file_name": "a_ajami_00133.png", "transcript": "Wa zai so ganin marar kyan ɗabi’a", "source": "3"}
{"file_name": "a_ajami_00134.png", "transcript": "Har ma mu yi abotaka don sana’a", "source": "3"}
{"file_name": "a_ajami_00135.png", "transcript": "Domin an ga ba ku kiyawuk ɗabi’a", "source": "3"}
{"file_name": "a_ajami_00136.png", "transcript": "Don Allah ku bar zama ba sana’a", "source": "3"}
{"file_name": "a_ajami_00137.png", "transcript": "In kun yarda za ku ji ku yi sana’a", "source": "3"}
{"file_name": "a_ajami_00138.png", "transcript": "Kar ku yi kanzagin kuɗa kun ga ku yi sana’a", "source": "3"}
{"file_name": "a_ajami_00139.png", "transcript": "Domin babu su a babin sana’a", "source": "3"}
{"file_name": "a_ajami_00140.png", "transcript": "Mene ne ya sa kuke ƙin sana’a", "source": "3"}
{"file_name": "a_ajami_00141.png", "transcript": "Domin ko a zaune sai a yi sana’a", "source": "3"}
{"file_name": "a_ajami_00142.png", "transcript": "Wataƙil shi ya sa kuke ƙin sana’a", "source": "3"}
{"file_name": "a_ajami_00143.png", "transcript": "Ko aure mutum ya nema garinnan", "source": "3"}
{"file_name": "a_ajami_00144.png", "transcript": "Sarki na ga ya yi doka ta kirki", "source": "3"}
{"file_name": "a_ajami_00145.png", "transcript": "Ni babban abinda ke ba ni haushi", "source": "3"}
{"file_name": "a_ajami_00146.png", "transcript": "Ko ka gano mutum jiki lafiya lau", "source": "3"}
{"file_name": "a_ajami_00147.png", "transcript": "Ba kuturu ba kun ga shi ba makaho", "source": "3"}
{"file_name": "a_ajami_00148.png", "transcript": "Idan suka zo suna bara kar a basu", "source": "3"}
{"file_name": "a_ajami_00149.png", "transcript": "Masakai za a dinga baiwa Allah", "source": "3"}
{"file_name": "a_ajami_00150.png", "transcript": "Na zo kanku masu ƙaryar sharifta", "source": "3"}
{"file_name": "a_ajami_00151.png", "transcript": "Kaga ƙato waje-waje na ta yawo", "source": "3"}
{"file_name": "a_ajami_00152.png", "transcript": "Mai ƙaryar shariftaka, to ka daina", "source": "3"}
{"file_name": "a_ajami_00153.png", "transcript": "Allah Ya la’anci ƙaryar sharifta", "source": "3"}
{"file_name": "a_ajami_00154.png", "transcript": "Mafi girma gareshi Allah Tabara", "source": "3"}
{"file_name": "a_ajami_00155.png", "transcript": "Domin an sani shariffai na Allah", "source": "3"}
{"file_name": "a_ajami_00156.png", "transcript": "Ya Allah ba mu albarkacinsu", "source": "3"}
{"file_name": "a_ajami_00157.png", "transcript": "Domin du a duniya in ka duba", "source": "3"}
{"file_name": "a_ajami_00158.png", "transcript": "Duba in ma’aikata sun taho man", "source": "3"}
{"file_name": "a_ajami_00159.png", "transcript": "Da sun je kama masu laifi da aibi", "source": "3"}
{"file_name": "a_ajami_00160.png", "transcript": "Kyautar duniya ana baiwa-bawa", "source": "3"}
{"file_name": "a_ajami_00161.png", "transcript": "Mai barcin dare da rana daƙiƙi", "source": "3"}
{"file_name": "a_ajami_00162.png", "transcript": "ba a bashi sai yana yin sana’a", "source": "3"}
{"file_name": "a_ajami_00163.png", "transcript": "Da yacce kar a bar mararsa sana’a", "source": "3"}
{"file_name": "a_ajami_00164.png", "transcript": "Babu kamar zama kawai ba sana’a", "source": "3"}
{"file_name": "a_ajami_00165.png", "transcript": "Amma wai yana bara ba sana’a", "source": "3"}
{"file_name": "a_ajami_00166.png", "transcript": "Wai mai lafiya yana ƙin sana’a", "source": "3"}
{"file_name": "a_ajami_00167.png", "transcript": "Ba’a taimakon mara kyan ɗabi’ah", "source": "3"}
{"file_name": "a_ajami_00168.png", "transcript": "Da faƙirai masu kyawun ɗabī’ah", "source": "3"}
{"file_name": "a_ajami_00169.png", "transcript": "Makwaɗaita waɗanda ba sa sana’a", "source": "3"}
{"file_name": "a_ajami_00170.png", "transcript": "Wai shi ga sharufta ba ya sana’a", "source": "3"}
{"file_name": "a_ajami_00171.png", "transcript": "Girman kai ku yaddashi ku yi sana’a", "source": "3"}
{"file_name": "a_ajami_00172.png", "transcript": "Ƙaulin Annabinmu, ƙaulin Shariʿa", "source": "3"}
{"file_name": "a_ajami_00173.png", "transcript": "Mai tsoron sa, wanda ke bin Shariʿa", "source": "3"}
{"file_name": "a_ajami_00174.png", "transcript": "Ba sa yin kwaɗai sabili da ɗa’a", "source": "3"}
{"file_name": "a_ajami_00175.png", "transcript": "Sa buɗi ga dukkan mai yin sana’a", "source": "3"}
{"file_name": "a_ajami_00176.png", "transcript": "Ba banza irin marar yin sana’a", "source": "3"}
{"file_name": "a_ajami_00177.png", "transcript": "Ba sa kama wanda ke yin sana’a", "source": "3"}
{"file_name": "a_ajami_00178.png", "transcript": "Sai su haɗa da wanda ba ya sana’a", "source": "3"}
{"file_name": "a_ajami_00179.png", "transcript": "Shashi sai ta zo ta hanyar sana’a", "source": "3"}
{"file_name": "a_ajami_00180.png", "transcript": "Shi dai ba rabansa ba ya sana’a", "source": "3"}
{"file_name": "a_ajami_00181.png", "transcript": "Ni na tabbata kuɗi arziƙi ne", "source": "3"}
{"file_name": "a_ajami_00182.png", "transcript": "Ina kun biyar a nan zani Legas", "source": "3"}
{"file_name": "a_ajami_00183.png", "transcript": "A babbar kotu zana ce sun ci bashi", "source": "3"}
{"file_name": "a_ajami_00184.png", "transcript": "Du in tsoratar dasu su daina", "source": "3"}
{"file_name": "a_ajami_00185.png", "transcript": "Ko a jiya ka bai mara yin sana’a", "source": "3"}
{"file_name": "a_ajami_00186.png", "transcript": "In ka jiya ka ce ya ɗauko ya baka", "source": "3"}
{"file_name": "a_ajami_00187.png", "transcript": "Sai rikici da kai da shi nan ya tashi", "source": "3"}
{"file_name": "a_ajami_00188.png", "transcript": "Mai san naka shi ko bai baka nasa", "source": "3"}
{"file_name": "a_ajami_00189.png", "transcript": "Mummunar zato idan zaka yi shi", "source": "3"}
{"file_name": "a_ajami_00190.png", "transcript": "Kyakyawan zato idan zaka yi shi", "source": "3"}
{"file_name": "a_ajami_00191.png", "transcript": "Mabuɗin arziƙi fa to yin sana’a", "source": "3"}
{"file_name": "a_ajami_00192.png", "transcript": "Nan zan sallama da ku ni Aminu", "source": "3"}
{"file_name": "a_ajami_00193.png", "transcript": "Aminu ne Kano mawaƙu a Yalwa", "source": "3"}
{"file_name": "a_ajami_00194.png", "transcript": "Abban [baban] Safiya da Abu nin Aminu", "source": "3"}
{"file_name": "a_ajami_00195.png", "transcript": "Ban waƙa ba don a ce nai fusaha", "source": "3"}
{"file_name": "a_ajami_00196.png", "transcript": "Hijira ta hi ɗari uku da tamanin", "source": "3"}
{"file_name": "a_ajami_00197.png", "transcript": "Salli [Salati] ubangiji ga shumagabanmu", "source": "3"}
{"file_name": "a_ajami_00198.png", "transcript": "Tammat bi ḥamdi l-Lāh wa ḥusni awnihi", "source": "3"}
{"file_name": "a_ajami_00199.png", "transcript": "Bi qalami Malam Yaro Hakayi Yalwa", "source": "3"}
{"file_name": "a_ajami_00200.png", "transcript": "Ba’a samunsu sai ta hanyar sana’a", "source": "3"}
{"file_name": "a_ajami_00201.png", "transcript": "Zan ƙaras waɗanda basa sana’a", "source": "3"}
{"file_name": "a_ajami_00202.png", "transcript": "Kuma ba sa biya fa sai mun Shari’a", "source": "3"}
{"file_name": "a_ajami_00203.png", "transcript": "Ƙarshe kai da shi fa sai kun Shari’a", "source": "3"}
{"file_name": "a_ajami_00204.png", "transcript": "Zaman banza duringa dai yin sana’a", "source": "3"}
{"file_name": "a_ajami_00205.png", "transcript": "Cewa zai yi ya ɓaci babu a’a", "source": "3"}
{"file_name": "a_ajami_00206.png", "transcript": "Bar huɗɗa da wanda ba ya sana’a", "source": "3"}
{"file_name": "a_ajami_00207.png", "transcript": "Shi ne mai kuɗi da munin ɗabia’a", "source": "3"}
{"file_name": "a_ajami_00208.png", "transcript": "Sai ka yi can wajan marar yin sana’a", "source": "3"}
{"file_name": "a_ajami_00209.png", "transcript": "Yi shi ga muminin mutun mai yin sana’a", "source": "3"}
{"file_name": "a_ajami_00210.png", "transcript": "Makullin arziki rashin yin sana’a", "source": "3"}
{"file_name": "a_ajami_00211.png", "transcript": "Mu jin hajiya na bar mai kyan yin ɗabi’a", "source": "3"}
{"file_name": "a_ajami_00212.png", "transcript": "Kuma ni taila ne ina yin sana’a", "source": "3"}
{"file_name": "a_ajami_00213.png", "transcript": "Baban Maimuna mawaƙin sana’a", "source": "3"}
{"file_name": "a_ajami_00214.png", "transcript": "Sai dai na yi dan a ji ai sana’a", "source": "3"}
{"file_name": "a_ajami_00215.png", "transcript": "Ka san ya biyar kasa dubu kai sharia", "source": "3"}
{"file_name": "a_ajami_00216.png", "transcript": "Har Ali sahabatu masu ɗa’a ", "source": "3"}
{"file_name": "a_ajami_00217.png", "transcript": "Waƙar Karuwa, Uwar Mugu", "source": "4"}
{"file_name": "a_ajami_00218.png", "transcript": "daga Hamisu Yadudu Funtua", "source": "4"}
{"file_name": "a_ajami_00219.png", "transcript": "Allāh sarki da yai mu duka", "source": "4"}
{"file_name": "a_ajami_00220.png", "transcript": "Ka yafe dhanbbanmu dan rahmarka", "source": "4"}
{"file_name": "a_ajami_00221.png", "transcript": "Ka tsarasshemu daga aiyukan halaka", "source": "4"}
{"file_name": "a_ajami_00222.png", "transcript": "Muna yin yabo da salati duka", "source": "4"}
{"file_name": "a_ajami_00223.png", "transcript": "Ga Annabi Shugaban Rai duka", "source": "4"}
{"file_name": "a_ajami_00224.png", "transcript": "A ya ƴan uwana samari ku zo", "source": "4"}
{"file_name": "a_ajami_00225.png", "transcript": "Ku dubi abinda yake je ya zo", "source": "4"}
{"file_name": "a_ajami_00226.png", "transcript": "Ku dena haƙilo a hanga hazo", "source": "4"}
{"file_name": "a_ajami_00227.png", "transcript": "Kar dai ka yarda da shiftar gizo", "source": "4"}
{"file_name": "a_ajami_00228.png", "transcript": "Nufi na kilaki uwar masu cizo", "source": "4"}
{"file_name": "a_ajami_00229.png", "transcript": "Karuwa ba ta gwani ku fahimta", "source": "4"}
{"file_name": "a_ajami_00230.png", "transcript": "Kowa ya bata, shi ne gwaninta", "source": "4"}
{"file_name": "a_ajami_00231.png", "transcript": "Buƙatarta safe da yamma a bata", "source": "4"}
{"file_name": "a_ajami_00232.png", "transcript": "Kowa ya ɗaukewa ɗauka buƙata", "source": "4"}
{"file_name": "a_ajami_00233.png", "transcript": "Watan wataran za shi koma baranta", "source": "4"}
{"file_name": "a_ajami_00234.png", "transcript": "Kar ka bi hanyarta ɓata gari", "source": "4"}
{"file_name": "a_ajami_00235.png", "transcript": "Kar ka bi don ba ta kai ka gari", "source": "4"}
{"file_name": "a_ajami_00236.png", "transcript": "San dai ta kai ka takin hadari", "source": "4"}
{"file_name": "a_ajami_00237.png", "transcript": "A maishe ka wawa kana garari", "source": "4"}
{"file_name": "a_ajami_00238.png", "transcript": "A ƙarshe ta barka da roƙon ɗar", "source": "4"}
{"file_name": "a_ajami_00239.png", "transcript": "Takan yadda malam da hila tata", "source": "4"}
{"file_name": "a_ajami_00240.png", "transcript": "Dalilinta sarki yakan bar sarauta", "source": "4"}
{"file_name": "a_ajami_00241.png", "transcript": "Takan maida tajiri, ɗan farauta", "source": "4"}
{"file_name": "a_ajami_00242.png", "transcript": "Takan kashe aure da gulma tata", "source": "4"}
{"file_name": "a_ajami_00243.png", "transcript": "Kowa bi hanyarta ya bi ɓata", "source": "4"}
{"file_name": "a_ajami_00244.png", "transcript": "Malam tsaya ka ji halin kilaki", "source": "4"}
{"file_name": "a_ajami_00245.png", "transcript": "Na farkonsu dai ba ruwanta da aiki", "source": "4"}
{"file_name": "a_ajami_00246.png", "transcript": "Babbar iyadarta wanka da wanki", "source": "4"}
{"file_name": "a_ajami_00247.png", "transcript": "Idan ta ce ta ƙoshi mai share ɗaki", "source": "4"}
{"file_name": "a_ajami_00248.png", "transcript": "Ta hau kan kujera ta koma a ɗaki", "source": "4"}
{"file_name": "a_ajami_00249.png", "transcript": "Takan sake murya idan ta ga kurɗi", "source": "4"}
{"file_name": "a_ajami_00250.png", "transcript": "Ta ce ita Ikko take ko Makurɗi", "source": "4"}
{"file_name": "a_ajami_00251.png", "transcript": "Idan ta ji sunanka ba ta faɗi", "source": "4"}
{"file_name": "a_ajami_00252.png", "transcript": "Takan zaɓi suna da duk ya fi daɗi", "source": "4"}
{"file_name": "a_ajami_00253.png", "transcript": "Ta sa maka domin ta samu kuɗi", "source": "4"}
{"file_name": "a_ajami_00254.png", "transcript": "In ta ga ta harbu, ba ta faɗi", "source": "4"}
{"file_name": "a_ajami_00255.png", "transcript": "Sai tai shiru kowa fa na baya faɗi", "source": "4"}
{"file_name": "a_ajami_00256.png", "transcript": "Ke ƙoƙi ko uwar ƙin kaɗi", "source": "4"}
{"file_name": "a_ajami_00257.png", "transcript": "Halinta ƙarya da zamba da ruɗi", "source": "4"}
{"file_name": "a_ajami_00258.png", "transcript": "Algunguma mai idan cin kuɗi", "source": "4"}
{"file_name": "a_ajami_00259.png", "transcript": "Tana maida zance tana rangwaɗa", "source": "4"}
{"file_name": "a_ajami_00260.png", "transcript": "Tai magana sai ka ce mai raɗa", "source": "4"}
{"file_name": "a_ajami_00261.png", "transcript": "Tana yi tana ɗaga ƴan kafaɗa", "source": "4"}
{"file_name": "a_ajami_00262.png", "transcript": "Kamar wanda ya shiga filin kiɗa", "source": "4"}
{"file_name": "a_ajami_00263.png", "transcript": "Ka ji ƙarautau maras mafaɗi", "source": "4"}
{"file_name": "a_ajami_00264.png", "transcript": "In ko ta ganka da halin talauci", "source": "4"}
{"file_name": "a_ajami_00265.png", "transcript": "Sai ka ga ta murtuke don butulci", "source": "4"}
{"file_name": "a_ajami_00266.png", "transcript": "Takan tsiri shara tana feshe hanci", "source": "4"}
{"file_name": "a_ajami_00267.png", "transcript": "Koko ta ce tashi ni zan yi barci", "source": "4"}
{"file_name": "a_ajami_00268.png", "transcript": "Dan ta ga ba ka da kaya na ci", "source": "4"}
{"file_name": "a_ajami_00269.png", "transcript": "Akwai sake suna wajen karuwa", "source": "4"}
{"file_name": "a_ajami_00270.png", "transcript": "Idan ka ji sunanta Kande a Yarwa", "source": "4"}
{"file_name": "a_ajami_00271.png", "transcript": "A birnin Kano ka ji sunanta Yalwa", "source": "4"}
{"file_name": "a_ajami_00272.png", "transcript": "Koko ta ce Binta mai aduwa", "source": "4"}
{"file_name": "a_ajami_00273.png", "transcript": "Sunanta ya fi dubu karuwa", "source": "4"}
{"file_name": "a_ajami_00274.png", "transcript": "Sunanta A’i cikin Katsina", "source": "4"}
{"file_name": "a_ajami_00275.png", "transcript": "A Sokoto ko sai ta ce Maimuna", "source": "4"}
{"file_name": "a_ajami_00276.png", "transcript": "Ko kuwa Rabi idan tai Kaduna", "source": "4"}
{"file_name": "a_ajami_00277.png", "transcript": "Sunanta Ladi a birnin Mina", "source": "4"}
{"file_name": "a_ajami_00278.png", "transcript": "Na Ikko daban ne da na ko’ina", "source": "4"}
{"file_name": "a_ajami_00279.png", "transcript": "Aboki kazan yi kana Ankarra", "source": "4"}
{"file_name": "a_ajami_00280.png", "transcript": "Cutarta ta fi gaban gobara", "source": "4"}
{"file_name": "a_ajami_00281.png", "transcript": "Haskenta ba arziqi sai Khasara", "source": "4"}
{"file_name": "a_ajami_00282.png", "transcript": "Sanyi a gindinta ya fi kwara", "source": "4"}
{"file_name": "a_ajami_00283.png", "transcript": "Ka lura, ka saurari tau shawara", "source": "4"}
{"file_name": "a_ajami_00284.png", "transcript": "Takan tsiri yawo da babu dalili", "source": "4"}
{"file_name": "a_ajami_00285.png", "transcript": "Takan guzurin maida ɗan goro, ƙyalle", "source": "4"}
{"file_name": "a_ajami_00286.png", "transcript": "Madubi da hoda kamar za ta koli", "source": "4"}
{"file_name": "a_ajami_00287.png", "transcript": "Takan kwalliya ta fito dandali", "source": "4"}
{"file_name": "a_ajami_00288.png", "transcript": "Babban zagi nata shi ne kawali", "source": "4"}
{"file_name": "a_ajami_00289.png", "transcript": "Būrinta sabon gari ko fagge", "source": "4"}
{"file_name": "a_ajami_00290.png", "transcript": "Yawanci tudun wada can suka dage", "source": "4"}
{"file_name": "a_ajami_00291.png", "transcript": "Da su da maroƙansu fuska su goge", "source": "4"}
{"file_name": "a_ajami_00292.png", "transcript": "Molo, garaya suke so da goge", "source": "4"}
{"file_name": "a_ajami_00293.png", "transcript": "Kaɗan karuwai babu tankar ya goge", "source": "4"}
{"file_name": "a_ajami_00294.png", "transcript": "Giya ce abincinta safe da yamma", "source": "4"}
{"file_name": "a_ajami_00295.png", "transcript": "Ba ta buƙatar tuwo ko rama", "source": "4"}
{"file_name": "a_ajami_00296.png", "transcript": "Wai ita ta riƙa sai alkama", "source": "4"}
{"file_name": "a_ajami_00297.png", "transcript": "Sai alkubus wata sa’a da nama", "source": "4"}
{"file_name": "a_ajami_00298.png", "transcript": "Ruwan shanta ma sai takan sa zuma", "source": "4"}
{"file_name": "a_ajami_00299.png", "transcript": "Takan ƙin rakaka da kayan ado", "source": "4"}
{"file_name": "a_ajami_00300.png", "transcript": "Fulloli, katifu ta ɗaura gado", "source": "4"}
