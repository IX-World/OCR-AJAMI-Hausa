{"file_name": "ajami_00182.png", "transcript": "Alḥamdu lahu wa lā ilāha ghayruhu", "source": "16"}
{"file_name": "ajami_00183.png", "transcript": "Mun bi Sarki wanda Ya yi mu", "source": "16"}
{"file_name": "ajami_00184.png", "transcript": "Wanda yayyo shugabanmu", "source": "16"}
{"file_name": "ajami_00185.png", "transcript": "Shi ka ceto ran Qiyāma", "source": "16"}
{"file_name": "ajami_00186.png", "transcript": "Annabinmu Muḥammadun fakewa", "source": "16"}
{"file_name": "ajami_00187.png", "transcript": "Bayan Bismillah Allah", "source": "16"}
{"file_name": "ajami_00188.png", "transcript": "Mun Ṣalāti gun sa Allah", "source": "16"}
{"file_name": "ajami_00189.png", "transcript": "Wa sahabbai nai don Ḥawāluh", "source": "16"}
{"file_name": "ajami_00190.png", "transcript": "Har ɗiya nasu duk muke gamawa", "source": "16"}
{"file_name": "ajami_00191.png", "transcript": "Ƴan uwa ku taho Mujālah", "source": "16"}
{"file_name": "ajami_00192.png", "transcript": "Mu yi gudu don sonsa Jallah", "source": "16"}
{"file_name": "ajami_00193.png", "transcript": "Mu yi riƙo wurudi da Ṣallah", "source": "16"}
{"file_name": "ajami_00194.png", "transcript": "Lāzimi daɗa shi muke gwadawa", "source": "16"}
{"file_name": "ajami_00195.png", "transcript": "Kaito wawa ba shi dubi", "source": "16"}
{"file_name": "ajami_00196.png", "transcript": "Ga fa hanya babu ruɗi", "source": "16"}
{"file_name": "ajami_00197.png", "transcript": "Babu yunwa sai fa jiɓi", "source": "16"}
{"file_name": "ajami_00198.png", "transcript": "Ba ƙishirwa, babu kwarin ɓacewa", "source": "16"}
{"file_name": "ajami_00199.png", "transcript": "Kaito kaito da kai guba", "source": "16"}
{"file_name": "ajami_00200.png", "transcript": "Ka ƙi bin labin Waliyyi", "source": "16"}